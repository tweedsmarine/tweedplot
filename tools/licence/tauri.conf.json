{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TweedPlot Licence Manager",
  "version": "0.1.0",
  "identifier": "nz.tweedsmarine.licence",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TweedPlot Licence Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../app/src-tauri/icons/32x32.png",
      "../../app/src-tauri/icons/128x128.png",
      "../../app/src-tauri/icons/icon.png",
      "../../app/src-tauri/icons/icon.ico"
    ]
  }
}