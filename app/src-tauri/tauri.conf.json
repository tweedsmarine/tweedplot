{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TweedPlot",
  "version": "1.0.0-alpha",
  "identifier": "nz.tweedsmarine.tweedplot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TweedPlot — Professional Marine Chart Plotter",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/world_depth.gpkg",
      "resources/polars/*"
    ],
    "publisher": "TweedsMarine",
    "homepage": "https://tweedsmarine.nz",
    "copyright": "© TweedsMarine",
    "shortDescription": "TweedPlot: Professional Marine Chart Plotter",
    "longDescription": "TweedPlot, from TweedsMarine (tweedsmarine.nz): vector charts from LINZ data, weather routing, GRIB and ocean data, AIS, race tracking and instruments."
  },
  "mainBinaryName": "TweedPlot"
}